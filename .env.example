# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Local SQLite database (not included in the GitHub repository)
SQLITE_DATABASE_PATH=./data/gold_support.db

# Gradio Application
APP_HOST=127.0.0.1
APP_PORT=7860

# Read-only SQL Safety and Database Settings
SQL_MAX_ROWS=200
DB_CONNECT_TIMEOUT=5
